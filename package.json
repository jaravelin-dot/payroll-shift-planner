{
  "name": "payroll-shift-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mzdy --local",
    "db:migrate:remote": "wrangler d1 migrations apply mzdy --remote",
    "deploy:rozpis": "wrangler deploy -c wrangler.rozpis.jsonc",
    "ikony": "node scripts/ikony.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "miniflare": "5.20261001.0-alpha",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "@types/node": "$@types/node"
  }
}
